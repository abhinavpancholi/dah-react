[{"intervention_code": "AIRD-51", "state": "Gujarat", "periodicity": "Yearly", "fy": "2022-23", "target_no_of_farmers_using_data_for_better_price_discovery": null, "actual_no_of_farmers_using_data_for_better_price_discovery": null, "remarks": "The KPI was prepared in September 2025 and the targets were set prospectively for the financial year 2025–26. Since the KPI was formulated during that period, there was no prior mechanism in place to capture or compile the relevant data for previous years. Therefore, historical data is not available."}, {"intervention_code": "AIRD-51", "state": "Gujarat", "periodicity": "Yearly", "fy": "2023-24", "target_no_of_farmers_using_data_for_better_price_discovery": null, "actual_no_of_farmers_using_data_for_better_price_discovery": null, "remarks": null}, {"intervention_code": "AIRD-51", "state": "Gujarat", "periodicity": "Yearly", "fy": "2024-25", "target_no_of_farmers_using_data_for_better_price_discovery": null, "actual_no_of_farmers_using_data_for_better_price_discovery": null, "remarks": null}, {"intervention_code": "AIRD-51", "state": "Gujarat", "periodicity": "Yearly", "fy": "2025-26", "target_no_of_farmers_using_data_for_better_price_discovery": 10000, "actual_no_of_farmers_using_data_for_better_price_discovery": null, "remarks": "There is no mechanism available on the AGMARKNET portal to track the number of individual farmers who have accessed or used the data for price discovery. While 305 APMC nodes from Gujarat are integrated with the portal and their data is available, user-wise or farmer-wise usage details are not recorded. Hence, achievement against the KPI related to farmer usage cannot be quantified."}, {"intervention_code": "AIRD-51", "state": "Gujarat", "periodicity": "Yearly", "fy": "2026-27", "target_no_of_farmers_using_data_for_better_price_discovery": null, "actual_no_of_farmers_using_data_for_better_price_discovery": null, "remarks": null}, {"intervention_code": "AIRD-51", "state": "Gujarat", "periodicity": "Ye